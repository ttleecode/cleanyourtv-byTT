diff --git a/launcher/app/src/test/java/com/gathin/tvhome/DockFillWidthTest.java b/launcher/app/src/test/java/com/gathin/tvhome/DockFillWidthTest.java
new file mode 100644
index 0000000..881bbd5
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/DockFillWidthTest.java
@@ -0,0 +1,43 @@
+package com.gathin.tvhome;
+
+import org.junit.Test;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+/** AppAdapter.tileWidthPx with dock_fill_width: no 180dp cap, still clear of the focus zoom and the screen height. */
+public class DockFillWidthTest {
+
+    private static final float D = 2f;              // 1080p TV: 2 px per dp
+    private static final int INNER = 1696;          // grid width minus padding at 1920 px (as TileFitTest)
+    private static final int GRID_H = 846;          // grid height under the top bar (as TileFitTest)
+
+    @Test
+    public void offKeepsTheCap() {
+        assertEquals(360, AppAdapter.tileWidthPx(INNER, 3, D));
+        assertEquals(AppAdapter.tileWidthPx(INNER, 3, D), AppAdapter.tileWidthPx(INNER, 3, false, D));
+        assertEquals(AppAdapter.tileWidthPx(INNER, GRID_H, 3, 2, true, true, D),
+                AppAdapter.tileWidthPx(INNER, GRID_H, 3, 2, true, true, false, D));
+    }
+
+    @Test
+    public void threeColumnsFillTheirCells() {
+        int w = AppAdapter.tileWidthPx(INNER, GRID_H, 3, 0, true, true, true, D);
+        assertEquals(491, w);                                   // (int) ((1696/3 - 24) / 1.1)
+        assertTrue(w * AppAdapter.FOCUS_SCALE <= INNER / 3f);   // the zoomed tile stays inside its cell
+    }
+
+    @Test
+    public void fourColumnsBarelyChange() {
+        int capped = AppAdapter.tileWidthPx(INNER, 4, D), filled = AppAdapter.tileWidthPx(INNER, 4, true, D);
+        assertTrue(filled >= capped && filled - capped <= 2 * D);   // 363 px instead of 360
+    }
+
+    @Test
+    public void oneColumnStillLeavesRoomForTheTitle() {
+        int w = AppAdapter.tileWidthPx(INNER, GRID_H, 1, 0, true, true, true, D);
+        int itemH = AppAdapter.itemHeightPx(AppAdapter.tileHeightPx(w), D);
+        float reserved = (AppAdapter.DOCK_EXTRA_DP + AppAdapter.BOTTOM_ROOM_DP + AppAdapter.TITLE_ROOM_DP) * D;
+        assertTrue(itemH + reserved <= GRID_H + 2);
+    }
+}
